generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST

  @@map("lead_status")
}

enum UserRole {
  ADMIN
  SALES_REP

  @@map("user_role")
}

enum PayoutType {
  BONUS
  SALARY
  COMMISSION
  OTHER

  @@map("payout_type")
}

enum PayoutStatus {
  PENDING
  PAID

  @@map("payout_status")
}

// Mirrors auth.users (id is a Supabase Auth user id); rows are created by the
// handle_new_user trigger on signup, never inserted directly by the app.
model User {
  id           String   @id @db.Uuid
  email        String   @unique
  name         String
  role         UserRole @default(SALES_REP)
  organization String?
  hourlyWage   Decimal? @map("hourly_wage") @db.Decimal(10, 2)
  hoursPerWeek Decimal? @map("hours_per_week") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leads   Lead[]
  payouts Payout[]
  w9Form  W9Form?

  @@map("users")
}

model Lead {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  company        String
  email          String?
  phone          String?
  mobile         String?
  website        String?
  address        String?
  city           String?
  state          String?
  zipCode        String?    @map("zip_code")
  country        String?
  industry       String?
  value          Decimal    @default(0) @db.Decimal(12, 2)
  status         LeadStatus @default(NEW)
  source         String?
  notes          String?
  assignedRepId  String     @map("assigned_rep_id") @db.Uuid
  assignedRep    User       @relation(fields: [assignedRepId], references: [id])
  zohoLeadId     String?    @unique @map("zoho_lead_id")
  zohoSyncedAt   DateTime?  @map("zoho_synced_at")
  zohoSyncStatus String?    @map("zoho_sync_status")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  order          Order?
  payouts        Payout[]

  @@index([assignedRepId])
  @@index([status])
  @@index([zohoLeadId])
  @@map("leads")
}

// Auto-created (via the on_lead_won trigger) the moment a Lead's status
// flips to WON; tracks fulfillment through the print vendor (Inksoft).
model Order {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId                 String    @unique @map("lead_id") @db.Uuid
  lead                   Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  inksoftOrderNumber     String?   @map("inksoft_order_number")
  emailSentAt            DateTime? @map("email_sent_at")
  blanksShippedAt        DateTime? @map("blanks_shipped_at")
  mockupApprovedAt       DateTime? @map("mockup_approved_at")
  paymentSentToPrinterAt DateTime? @map("payment_sent_to_printer_at")
  orderShippedAt         DateTime? @map("order_shipped_at")
  trackingNumber         String?   @map("tracking_number")
  itemsReceivedAt        DateTime? @map("items_received_at")
  redAlert               Boolean   @default(false) @map("red_alert")
  redAlertNote           String?   @map("red_alert_note")
  stuckInDelivery        Boolean   @default(false) @map("stuck_in_delivery")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("orders")
}

model Payout {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repId       String       @map("rep_id") @db.Uuid
  rep         User         @relation(fields: [repId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  date        DateTime
  description String
  type        PayoutType   @default(BONUS)
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?    @map("paid_at")
  leadId      String?      @map("lead_id") @db.Uuid
  lead        Lead?        @relation(fields: [leadId], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([repId])
  @@index([leadId])
  @@index([type])
  @@index([status])
  @@map("payouts")
}

model ZohoToken {
  id           Int      @id @default(1)
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("zoho_tokens")
}

// TIN is stored encrypted (see src/lib/tax/crypto.ts) - tinLast4 is plaintext
// purely for display ("on file, ending in 1234").
model W9Form {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName         String   @map("legal_name")
  businessName      String?  @map("business_name")
  taxClassification String   @map("tax_classification")
  tinEncrypted      String   @map("tin_encrypted")
  tinLast4          String   @map("tin_last4")
  address           String
  city              String
  state             String
  zipCode           String   @map("zip_code")
  submittedAt       DateTime @default(now()) @map("submitted_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("w9_forms")
}

// Singleton row: the payer info that goes on every generated 1099-NEC.
model CompanySettings {
  id        Int      @id @default(1)
  legalName String   @default("Golden Printing Solutions") @map("legal_name")
  ein       String?
  address   String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}
